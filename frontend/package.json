{
  "name": "gakumotion-ui",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "GakuMotion plugin panel UI (WebView2 + React) hosted inside the GakuLoader plugin content area.",
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --open /?preview=1",
    "build": "tsc -b && vite build",
    "build:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1 -Dependencies Skip",
    "preview": "vite preview",
    "preview:build": "vite build --mode preview",
    "preview:serve": "vite build --mode preview && vite preview --outDir dist-preview --port 4173 --open /?preview=1",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@remixicon/react": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
